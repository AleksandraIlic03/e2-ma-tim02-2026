<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FBF7EF"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FEFEFE"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvChallengeGameTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/fredoka_bold"
            android:text="Izazov"
            android:textColor="#321C1C"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvChallengeTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:fontFamily="@font/fredoka_semibold"
            android:text="⏱ 0s"
            android:textColor="#823FAB"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvChallengeScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fredoka_bold"
            android:text="⭐ 0"
            android:textColor="#321C1C"
            android:textSize="16sp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- LOADING -->
            <LinearLayout
                android:id="@+id/panelLoading"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:gravity="center"
                android:orientation="vertical">
                <ProgressBar android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 1. KO ZNA ZNA -->
            <LinearLayout
                android:id="@+id/panelKoZnaZna"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvKzzQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:fontFamily="@font/fredoka_semibold"
                    android:textColor="#321C1C"
                    android:textSize="18sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnKzzAnswer1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:backgroundTint="#823FAB"
                    app:cornerRadius="20dp"
                    xmlns:app="http://schemas.android.com/apk/res-auto" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnKzzAnswer2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:backgroundTint="#823FAB"
                    app:cornerRadius="20dp"
                    xmlns:app="http://schemas.android.com/apk/res-auto" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnKzzAnswer3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:backgroundTint="#823FAB"
                    app:cornerRadius="20dp"
                    xmlns:app="http://schemas.android.com/apk/res-auto" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnKzzAnswer4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#823FAB"
                    app:cornerRadius="20dp"
                    xmlns:app="http://schemas.android.com/apk/res-auto" />

            </LinearLayout>

            <!-- 2. SPOJNICE -->
            <LinearLayout
                android:id="@+id/panelSpojnice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvSpojniceTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:fontFamily="@font/fredoka_semibold"
                    android:gravity="center"
                    android:textColor="#321C1C"
                    android:textSize="16sp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="4dp">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnSpLeft1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:enabled="false" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnSpLeft2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:enabled="false" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnSpLeft3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:enabled="false" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnSpLeft4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:enabled="false" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnSpLeft5" android:layout_width="match_parent" android:layout_height="wrap_content" android:enabled="false" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="4dp">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnSpRight1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnSpRight2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnSpRight3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnSpRight4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnSpRight5" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

            <!-- 3. ASOCIJACIJE -->
            <LinearLayout
                android:id="@+id/panelAsocijacije"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="2dp">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsA1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:layout_marginBottom="2dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsA2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:layout_marginBottom="2dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsA3" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:layout_marginBottom="2dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsA4" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:layout_marginBottom="4dp" />
                        <EditText android:id="@+id/etAsResA" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="A" android:textSize="11sp" android:imeOptions="actionDone" android:singleLine="true" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsB1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:layout_marginBottom="2dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsB2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:layout_marginBottom="2dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsB3" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:layout_marginBottom="2dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsB4" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:layout_marginBottom="4dp" />
                        <EditText android:id="@+id/etAsResB" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="B" android:textSize="11sp" android:imeOptions="actionDone" android:singleLine="true" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="2dp" android:layout_marginEnd="2dp">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsV1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:layout_marginBottom="2dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsV2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:layout_marginBottom="2dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsV3" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:layout_marginBottom="2dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsV4" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:layout_marginBottom="4dp" />
                        <EditText android:id="@+id/etAsResV" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="V" android:textSize="11sp" android:imeOptions="actionDone" android:singleLine="true" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="2dp">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsG1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:layout_marginBottom="2dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsG2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:layout_marginBottom="2dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsG3" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:layout_marginBottom="2dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAsG4" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:layout_marginBottom="4dp" />
                        <EditText android:id="@+id/etAsResG" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="G" android:textSize="11sp" android:imeOptions="actionDone" android:singleLine="true" />
                    </LinearLayout>
                </LinearLayout>

                <EditText
                    android:id="@+id/etAsResFinal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/final_resenje_bg"
                    android:gravity="center"
                    android:hint="Konačno rešenje"
                    android:imeOptions="actionDone"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

            </LinearLayout>

            <!-- 4. SKOČKO -->
            <LinearLayout
                android:id="@+id/panelSkocko"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvSkAttemptsHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/fredoka_regular"
                    android:textColor="#321C1C"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvSkCurrentInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/input_bg_rounded"
                    android:gravity="center"
                    android:padding="12dp"
                    android:textSize="18sp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnSkSym1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="2dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnSkSym2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="2dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnSkSym3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="2dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnSkSym4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="2dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnSkSym5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="2dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnSkSym6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="2dp" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnSkDelete" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="OBRIŠI" android:backgroundTint="#C62828" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnSkConfirm" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:text="POTVRDI" android:backgroundTint="#4CAF50" />
                </LinearLayout>

            </LinearLayout>

            <!-- 5. KORAK PO KORAK -->
            <LinearLayout
                android:id="@+id/panelKorakPoKorak"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvKpkPointsHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/fredoka_semibold"
                    android:textColor="#823FAB"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/llChallengeSteps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/etKpkAnswer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Tvoj odgovor"
                    android:background="@drawable/input_bg_rounded"
                    android:padding="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnKpkGuess"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#823FAB"
                    android:text="POGODI" />

            </LinearLayout>

            <!-- 6. MOJ BROJ -->
            <LinearLayout
                android:id="@+id/panelMojBroj"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvMbTarget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/fredoka_bold"
                    android:gravity="center"
                    android:textColor="#823FAB"
                    android:textSize="36sp" />

                <LinearLayout
                    android:id="@+id/llMbNumbers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvMbExpression"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/input_bg_rounded"
                    android:gravity="center"
                    android:padding="12dp"
                    android:textSize="18sp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnMbPlus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="2dp" android:text="+" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnMbMinus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="2dp" android:text="−" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnMbMultiply" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="2dp" android:text="×" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnMbDivide" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="2dp" android:text="÷" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnMbClear" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="OČISTI" android:backgroundTint="#C62828" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnMbConfirm" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:text="POTVRDI" android:backgroundTint="#4CAF50" />
                </LinearLayout>

            </LinearLayout>

        </FrameLayout>
    </ScrollView>

</LinearLayout>