<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FBF7EF"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FEFEFE"
        android:elevation="4dp"
        app:titleTextColor="#321C1C" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNewChallenge"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:backgroundTint="#823FAB"
        android:fontFamily="@font/fredoka_bold"
        android:text="POSTAVI NOVI IZAZOV"
        android:textColor="#FFFFFF"
        app:cornerRadius="100dp" />

    <TextView
        android:id="@+id/tvEmptyChallenges"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:fontFamily="@font/fredoka_regular"
        android:gravity="center"
        android:text="Trenutno nema aktivnih izazova u tvom regionu."
        android:textColor="#877777"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChallenges"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="12dp" />

</LinearLayout>