<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/inviteContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    android:background="@drawable/dialog_bg_rounded"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="🎮"
        android:textSize="44sp" />

    <TextView
        android:id="@+id/tvInviteTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/fredoka_bold"
        android:gravity="center"
        android:text="Poziv za partiju"
        android:textColor="#321C1C"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/tvInviteMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/fredoka_regular"
        android:gravity="center"
        android:text="Igrač vas poziva na partiju."
        android:textColor="#877777"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInviteReject"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:fontFamily="@font/fredoka_bold"
            android:text="Odbij"
            android:textAllCaps="false"
            android:textColor="#823FAB"
            app:cornerRadius="24dp"
            app:strokeColor="#823FAB"
            app:strokeWidth="2dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInviteAccept"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="#823FAB"
            android:fontFamily="@font/fredoka_bold"
            android:text="Prihvati"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:cornerRadius="24dp" />

    </LinearLayout>

</LinearLayout>