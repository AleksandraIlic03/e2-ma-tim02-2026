<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FEFEFE">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvChallengeCreator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fredoka_bold"
            android:textColor="#321C1C"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvChallengeStake"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/fredoka_semibold"
            android:textColor="#823FAB"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvChallengeParticipants"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/fredoka_regular"
            android:textColor="#877777"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnJoinChallenge"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#823FAB"
            android:fontFamily="@font/fredoka_bold"
            android:text="PRIDRUŽI SE"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            app:cornerRadius="100dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>