<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvResultRank"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fredoka_bold"
            android:text="🥇 1."
            android:textColor="#321C1C"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvResultName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fredoka_bold"
                android:text="Ime Igrača"
                android:textColor="#321C1C"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvResultScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fredoka_regular"
                android:text="0 bodova"
                android:textColor="#877777"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvResultPayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fredoka_bold"
            android:text="+0 ⭐ +0 🎟️"
            android:textColor="#4CAF50"
            android:textSize="15sp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>