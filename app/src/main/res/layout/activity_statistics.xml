<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FBF7EF"
    android:orientation="vertical"
    tools:ignore="HardcodedText">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:paddingHorizontal="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/fredoka_bold"
            android:text="STATISTIKA"
            android:textColor="#321C1C"
            android:textSize="20sp" />
    </RelativeLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:tabIndicatorColor="#823FAB"
        app:tabSelectedTextColor="#823FAB"
        app:tabTextColor="#877777"
        app:tabTextAppearance="@style/TextAppearance.MaterialComponents.Button"
        app:tabIndicatorHeight="3dp">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PREGLED" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IGRE" />
    </com.google.android.material.tabs.TabLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!--pregled-->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollOverview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="2">

                    <!-- Odigrano -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        android:layout_margin="6dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="100"
                                android:textSize="28sp"
                                android:fontFamily="@font/fredoka_bold"
                                android:textColor="#823FAB"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Odigrano"
                                android:textSize="14sp"
                                android:fontFamily="@font/fredoka_semibold"
                                android:textColor="#877777"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Pobede % -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        android:layout_margin="6dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="64%"
                                android:textSize="28sp"
                                android:fontFamily="@font/fredoka_bold"
                                android:textColor="#FFCA28"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pobede"
                                android:textSize="14sp"
                                android:fontFamily="@font/fredoka_semibold"
                                android:textColor="#877777"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Prosek -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        android:layout_margin="6dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="115"
                                android:textSize="28sp"
                                android:fontFamily="@font/fredoka_bold"
                                android:textColor="#823FAB"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Prosek poena"
                                android:textSize="14sp"
                                android:fontFamily="@font/fredoka_semibold"
                                android:textColor="#877777"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        android:layout_margin="6dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="36%"
                                android:textSize="28sp"
                                android:fontFamily="@font/fredoka_bold"
                                android:textColor="#F44336"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Porazi"
                                android:textSize="14sp"
                                android:fontFamily="@font/fredoka_semibold"
                                android:textColor="#877777"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </GridLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:layout_marginBottom="12dp"
                    android:text="Odnos pobeda i poraza"
                    android:fontFamily="@font/fredoka_bold"
                    android:textColor="#321C1C"
                    android:textSize="18sp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:orientation="horizontal"
                    android:background="@drawable/input_bg_rounded"
                    android:clipToOutline="true">
                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="6.4"
                        android:background="#823FAB"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="3.6"
                        android:background="#E0D8E8"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="64 Pobede"
                        android:textSize="13sp"
                        android:textColor="#823FAB"
                        android:fontFamily="@font/fredoka_semibold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="36 Poraza"
                        android:textSize="13sp"
                        android:textColor="#823FAB"
                        android:fontFamily="@font/fredoka_semibold"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:layout_marginBottom="20dp"
                    android:text="Prosečni poeni po igri"
                    android:fontFamily="@font/fredoka_bold"
                    android:textColor="#321C1C"
                    android:textSize="18sp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp">

                    <!-- KZZ -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_horizontal|bottom"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="18" android:textSize="12sp" android:fontFamily="@font/fredoka_semibold"/>
                        <View android:layout_width="28dp" android:layout_height="160dp" android:background="#823FAB" android:layout_marginBottom="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="KZZ" android:textSize="11sp" android:fontFamily="@font/fredoka_regular"/>
                    </LinearLayout>
                    <!-- MB -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_horizontal|bottom"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12" android:textSize="12sp" android:fontFamily="@font/fredoka_semibold"/>
                        <View android:layout_width="28dp" android:layout_height="100dp" android:background="#823FAB" android:layout_marginBottom="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MB" android:textSize="11sp" android:fontFamily="@font/fredoka_regular"/>
                    </LinearLayout>
                    <!-- KPK -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_horizontal|bottom"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="15" android:textSize="12sp" android:fontFamily="@font/fredoka_semibold"/>
                        <View android:layout_width="28dp" android:layout_height="140dp" android:background="#823FAB" android:layout_marginBottom="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="KPK" android:textSize="11sp" android:fontFamily="@font/fredoka_regular"/>
                    </LinearLayout>
                    <!-- SK -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_horizontal|bottom"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="22" android:textSize="12sp" android:fontFamily="@font/fredoka_semibold"/>
                        <View android:layout_width="28dp" android:layout_height="200dp" android:background="#823FAB" android:layout_marginBottom="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SK" android:textSize="11sp" android:fontFamily="@font/fredoka_regular"/>
                    </LinearLayout>
                    <!-- AS -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_horizontal|bottom"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="14" android:textSize="12sp" android:fontFamily="@font/fredoka_semibold"/>
                        <View android:layout_width="28dp" android:layout_height="130dp" android:background="#823FAB" android:layout_marginBottom="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AS" android:textSize="11sp" android:fontFamily="@font/fredoka_regular"/>
                    </LinearLayout>
                    <!-- SP -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_horizontal|bottom"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="20" android:textSize="12sp" android:fontFamily="@font/fredoka_semibold"/>
                        <View android:layout_width="28dp" android:layout_height="180dp" android:background="#823FAB" android:layout_marginBottom="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SP" android:textSize="11sp" android:fontFamily="@font/fredoka_regular"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- igre -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollGames"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Ko zna zna -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ko zna zna" android:fontFamily="@font/fredoka_bold" android:textColor="#823FAB" android:layout_marginBottom="12dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tačni vs Netačni odgovori" android:textSize="12sp" android:textColor="#877777" android:fontFamily="@font/fredoka_regular" android:layout_marginBottom="8dp"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="12dp" android:orientation="horizontal" android:background="#F5F5F5" android:clipToOutline="true">
                            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="7.5" android:background="#823FAB"/>
                            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2.5" android:background="#F44336"/>
                        </LinearLayout>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="75% Tačno" android:textSize="11sp" android:fontFamily="@font/fredoka_semibold" android:layout_marginTop="4dp" android:textColor="#823FAB"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Moj broj -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Moj broj" android:fontFamily="@font/fredoka_bold" android:textColor="#FFCA28" android:layout_marginBottom="4dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Uspešnost pronalaženja tačnog broja" android:textSize="12sp" android:textColor="#877777" android:fontFamily="@font/fredoka_regular"/>
                        </LinearLayout>
                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:progress="42"
                            app:indicatorSize="60dp"
                            app:trackThickness="8dp"
                            app:indicatorColor="#FFCA28"
                            app:trackColor="#FFF9C4"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Korak po korak -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Korak po korak" android:fontFamily="@font/fredoka_bold" android:textColor="#823FAB" android:layout_marginBottom="12dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pogodak po koracima" android:textSize="12sp" android:textColor="#877777" android:fontFamily="@font/fredoka_regular" android:layout_marginBottom="8dp"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                                <TextView android:layout_width="50dp" android:layout_height="wrap_content" android:text="Korak 1" android:textSize="11sp" android:fontFamily="@font/fredoka_semibold"/>
                                <ProgressBar android:layout_width="0dp" android:layout_height="8dp" android:layout_weight="1" android:progress="10" style="@android:style/Widget.ProgressBar.Horizontal" android:progressTint="#823FAB"/>
                            </LinearLayout>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                                <TextView android:layout_width="50dp" android:layout_height="wrap_content" android:text="Korak 2" android:textSize="11sp" android:fontFamily="@font/fredoka_semibold"/>
                                <ProgressBar android:layout_width="0dp" android:layout_height="8dp" android:layout_weight="1" android:progress="25" style="@android:style/Widget.ProgressBar.Horizontal" android:progressTint="#823FAB"/>
                            </LinearLayout>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                                <TextView android:layout_width="50dp" android:layout_height="wrap_content" android:text="Korak 3" android:textSize="11sp" android:fontFamily="@font/fredoka_semibold"/>
                                <ProgressBar android:layout_width="0dp" android:layout_height="8dp" android:layout_weight="1" android:progress="45" style="@android:style/Widget.ProgressBar.Horizontal" android:progressTint="#823FAB"/>
                            </LinearLayout>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                                <TextView android:layout_width="50dp" android:layout_height="wrap_content" android:text="Korak 4" android:textSize="11sp" android:fontFamily="@font/fredoka_semibold"/>
                                <ProgressBar android:layout_width="0dp" android:layout_height="8dp" android:layout_weight="1" android:progress="70" style="@android:style/Widget.ProgressBar.Horizontal" android:progressTint="#823FAB"/>
                            </LinearLayout>
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                                <TextView android:layout_width="50dp" android:layout_height="wrap_content" android:text="Korak 5" android:textSize="11sp" android:fontFamily="@font/fredoka_semibold"/>
                                <ProgressBar android:layout_width="0dp" android:layout_height="8dp" android:layout_weight="1" android:progress="90" style="@android:style/Widget.ProgressBar.Horizontal" android:progressTint="#823FAB"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Asocijacije -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Asocijacije" android:fontFamily="@font/fredoka_bold" android:textColor="#823FAB" android:layout_marginBottom="12dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rešene vs Nerešene" android:textSize="12sp" android:textColor="#877777" android:fontFamily="@font/fredoka_regular" android:layout_marginBottom="8dp"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="12dp" android:orientation="horizontal" android:background="#F5F5F5" android:clipToOutline="true">
                            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="5.8" android:background="#823FAB"/>
                            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="4.2" android:background="#D5C4E0"/>
                        </LinearLayout>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="58% Rešeno" android:textSize="11sp" android:fontFamily="@font/fredoka_semibold" android:layout_marginTop="4dp" android:textColor="#823FAB"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Skočko -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Skočko" android:fontFamily="@font/fredoka_bold" android:textColor="#823FAB" android:layout_marginBottom="12dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Uspešnost po pokušaju" android:textSize="12sp" android:textColor="#877777" android:fontFamily="@font/fredoka_regular" android:layout_marginBottom="12dp"/>
                        <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2" android:rowCount="3">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1. Pokušaj: 5%" android:textSize="11sp" android:layout_gravity="start" android:layout_columnWeight="1" android:fontFamily="@font/fredoka_semibold" android:layout_marginBottom="4dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2. Pokušaj: 12%" android:textSize="11sp" android:layout_gravity="start" android:layout_columnWeight="1" android:fontFamily="@font/fredoka_semibold" android:layout_marginBottom="4dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3. Pokušaj: 25%" android:textSize="11sp" android:layout_gravity="start" android:layout_columnWeight="1" android:fontFamily="@font/fredoka_semibold" android:layout_marginBottom="4dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4. Pokušaj: 40%" android:textSize="11sp" android:layout_gravity="start" android:layout_columnWeight="1" android:fontFamily="@font/fredoka_semibold" android:layout_marginBottom="4dp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5. Pokušaj: 65%" android:textSize="11sp" android:layout_gravity="start" android:fontFamily="@font/fredoka_semibold" android:layout_columnWeight="1"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6. Pokušaj: 85%" android:textSize="11sp" android:layout_gravity="start" android:fontFamily="@font/fredoka_semibold" android:layout_columnWeight="1"/>
                        </GridLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Spojnice -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
