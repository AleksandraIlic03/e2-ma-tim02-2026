<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5EEFF"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/input_bg_rounded"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp">
            <androidx.cardview.widget.CardView
                android:layout_width="28dp"
                android:layout_height="28dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">
                <ImageView
                    android:id="@+id/ivPlayer1Avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/circle_placeholder"
                    android:scaleType="centerCrop"
                    android:contentDescription="Player 1" />
            </androidx.cardview.widget.CardView>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:orientation="vertical">
                <TextView android:id="@+id/tvPlayer1Name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/fredoka_semibold" android:text="P1" android:textColor="#877777" android:textSize="12sp" />
                <TextView android:id="@+id/tvPlayer1Points" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/fredoka_bold" android:text="0" android:textColor="#321C1C" android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="6dp" android:fontFamily="@font/fredoka_bold" android:text="VS" android:textColor="#823FAB" android:textSize="13sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/input_bg_rounded"
            android:gravity="center_vertical|end"
            android:orientation="horizontal"
            android:padding="6dp">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="5dp" android:gravity="end" android:orientation="vertical">
                <TextView android:id="@+id/tvPlayer2Name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/fredoka_semibold"  android:textColor="#877777" android:textSize="12sp" />
                <TextView android:id="@+id/tvPlayer2Points" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/fredoka_bold" android:text="0" android:textColor="#321C1C" android:textSize="15sp" />
            </LinearLayout>
            <androidx.cardview.widget.CardView
                android:layout_width="28dp"
                android:layout_height="28dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">
                <ImageView
                    android:id="@+id/ivPlayer2Avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/circle_placeholder"
                    android:scaleType="centerCrop"
                    android:contentDescription="Player 2" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/tvTimer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/input_bg_rounded" android:fontFamily="@font/fredoka_bold" android:paddingHorizontal="12dp" android:paddingVertical="4dp" android:text="⏱ 30s" android:textColor="#823FAB" android:textSize="14sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:fontFamily="@font/fredoka_bold" android:text="SKOČKO" android:textColor="#2D1B4E" android:textSize="20sp" />
        <TextView android:id="@+id/tvPoints" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/input_bg_rounded" android:fontFamily="@font/fredoka_bold" android:paddingHorizontal="12dp" android:paddingVertical="4dp" android:text="⭐ 0" android:textColor="#E65100" android:textSize="14sp" />
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="7"
        app:cardBackgroundColor="#EADFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="6dp">

            <include android:id="@+id/row1" layout="@layout/item_skocko_row" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            <include android:id="@+id/row2" layout="@layout/item_skocko_row" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            <include android:id="@+id/row3" layout="@layout/item_skocko_row" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            <include android:id="@+id/row4" layout="@layout/item_skocko_row" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            <include android:id="@+id/row5" layout="@layout/item_skocko_row" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            <include android:id="@+id/row6" layout="@layout/item_skocko_row" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#B39DDB" android:layout_marginVertical="2dp" />

            <LinearLayout
                android:id="@+id/layoutStealRow"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.2"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/input_bg_rounded"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/tvStealLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="8dp"
                        android:textColor="#E65100"
                        android:fontFamily="@font/fredoka_bold"
                        android:textSize="10sp" />

                    <include android:id="@+id/row7" layout="@layout/item_skocko_row" android:layout_width="match_parent" android:layout_height="match_parent" />
                </FrameLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.1"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="3dp">

        <ImageButton android:id="@+id/btnSymbol1" android:layout_width="62dp" android:layout_height="62dp" android:layout_margin="1dp" android:background="@drawable/circle_placeholder" android:backgroundTint="#FFFFFF" android:padding="8dp" android:scaleType="centerInside" android:src="@drawable/img" android:contentDescription="Skočko" />
        <ImageButton android:id="@+id/btnSymbol2" android:layout_width="62dp" android:layout_height="62dp" android:layout_margin="1dp" android:background="@drawable/circle_placeholder" android:backgroundTint="#FFFFFF" android:padding="8dp" android:scaleType="centerInside" android:src="@drawable/ic_kvadrat" android:contentDescription="Kvadrat" />
        <ImageButton android:id="@+id/btnSymbol3" android:layout_width="62dp" android:layout_height="62dp" android:layout_margin="1dp" android:background="@drawable/circle_placeholder" android:backgroundTint="#FFFFFF" android:padding="8dp" android:scaleType="centerInside" android:src="@drawable/ic_krug" android:contentDescription="Krug" />
        <ImageButton android:id="@+id/btnSymbol4" android:layout_width="62dp" android:layout_height="62dp" android:layout_margin="1dp" android:background="@drawable/circle_placeholder" android:backgroundTint="#FFFFFF" android:padding="8dp" android:scaleType="centerInside" android:src="@drawable/ic_srce" android:contentDescription="Srce" />
        <ImageButton android:id="@+id/btnSymbol5" android:layout_width="62dp" android:layout_height="62dp" android:layout_margin="1dp" android:background="@drawable/circle_placeholder" android:backgroundTint="#FFFFFF" android:padding="8dp" android:scaleType="centerInside" android:src="@drawable/ic_trougao" android:contentDescription="Trougao" />
        <ImageButton android:id="@+id/btnSymbol6" android:layout_width="62dp" android:layout_height="62dp" android:layout_margin="1dp" android:background="@drawable/circle_placeholder" android:backgroundTint="#FFFFFF" android:padding="8dp" android:scaleType="centerInside" android:src="@drawable/ic_zvezda" android:contentDescription="Zvezda" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutSolution"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="2dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">
        <ImageView android:id="@+id/ivSol1" android:layout_width="56dp" android:layout_height="56dp" android:layout_margin="2dp" android:scaleType="centerInside" android:background="@drawable/circle_placeholder" android:backgroundTint="#823FAB" android:padding="6dp" />
        <ImageView android:id="@+id/ivSol2" android:layout_width="56dp" android:layout_height="56dp" android:layout_margin="2dp" android:scaleType="centerInside" android:background="@drawable/circle_placeholder" android:backgroundTint="#823FAB" android:padding="6dp" />
        <ImageView android:id="@+id/ivSol3" android:layout_width="56dp" android:layout_height="56dp" android:layout_margin="2dp" android:scaleType="centerInside" android:background="@drawable/circle_placeholder" android:backgroundTint="#823FAB" android:padding="6dp" />
        <ImageView android:id="@+id/ivSol4" android:layout_width="56dp" android:layout_height="56dp" android:layout_margin="2dp" android:scaleType="centerInside" android:background="@drawable/circle_placeholder" android:backgroundTint="#823FAB" android:padding="6dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.7"
        android:gravity="center"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnDelete" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="5dp" android:layout_weight="1" android:backgroundTint="#823FAB" android:fontFamily="@font/fredoka_bold" android:text="OBRIŠI" android:textColor="#FFFFFF" android:textSize="13sp" app:cornerRadius="12dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnConfirm" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="5dp" android:layout_weight="1" android:backgroundTint="#823FAB" android:fontFamily="@font/fredoka_bold" android:text="POTVRDI" android:textSize="13sp" app:cornerRadius="12dp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:backgroundTint="#24B874"
        android:fontFamily="@font/fredoka_bold"
        android:text="SLEDEĆA IGRA"
        android:visibility="gone"
        app:cornerRadius="12dp" />

</LinearLayout>
