<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5EEFF"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/input_bg_rounded"
            android:fontFamily="@font/fredoka_bold"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="⏱ 30s"
            android:textColor="#823FAB"
            android:textSize="16sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fredoka_bold"
            android:letterSpacing="0.08"
            android:text="SKOČKO"
            android:textColor="#2D1B4E"
            android:textSize="22sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvPoints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/input_bg_rounded"
            android:fontFamily="@font/fredoka_bold"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="⭐ 0"
            android:textColor="#E65100"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Game Board - weight 6 -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="6"
        app:cardBackgroundColor="#EADFFF"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:id="@+id/gameBoard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="8dp">

            <include android:id="@+id/row1" layout="@layout/item_skocko_row" />
            <include android:id="@+id/row2" layout="@layout/item_skocko_row" />
            <include android:id="@+id/row3" layout="@layout/item_skocko_row" />
            <include android:id="@+id/row4" layout="@layout/item_skocko_row" />
            <include android:id="@+id/row5" layout="@layout/item_skocko_row" />
            <include android:id="@+id/row6" layout="@layout/item_skocko_row" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Simboli - weight 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="6dp">

        <ImageButton
            android:id="@+id/btnSymbol1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/symbol_bg"
            android:foreground="?attr/selectableItemBackground"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/img"
            android:contentDescription="Skočko" />

        <ImageButton
            android:id="@+id/btnSymbol2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/symbol_bg"
            android:foreground="?attr/selectableItemBackground"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_kvadrat"
            android:contentDescription="Kvadrat" />

        <ImageButton
            android:id="@+id/btnSymbol3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/symbol_bg"
            android:foreground="?attr/selectableItemBackground"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_krug"
            android:contentDescription="Krug" />

        <ImageButton
            android:id="@+id/btnSymbol4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/symbol_bg"
            android:foreground="?attr/selectableItemBackground"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_srce"
            android:contentDescription="Srce" />

        <ImageButton
            android:id="@+id/btnSymbol5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/symbol_bg"
            android:foreground="?attr/selectableItemBackground"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_trougao"
            android:contentDescription="Trougao" />

        <ImageButton
            android:id="@+id/btnSymbol6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/symbol_bg"
            android:foreground="?attr/selectableItemBackground"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_zvezda"
            android:contentDescription="Zvezda" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutSolution"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="8dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fredoka_bold"
            android:text="TAČNA KOMBINACIJA:"
            android:textColor="#823FAB"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <ImageView android:id="@+id/ivSol1" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="4dp" android:scaleType="centerInside" />
            <ImageView android:id="@+id/ivSol2" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="4dp" android:scaleType="centerInside" />
            <ImageView android:id="@+id/ivSol3" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="4dp" android:scaleType="centerInside" />
            <ImageView android:id="@+id/ivSol4" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="4dp" android:scaleType="centerInside" />
        </LinearLayout>
    </LinearLayout>

    <!-- Dugmad - weight 0.7 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.7"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDelete"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="#823FAB"
            android:fontFamily="@font/fredoka_bold"
            android:text="OBRIŠI"
            android:textColor="#FFFFFF"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirm"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="#823FAB"
            android:fontFamily="@font/fredoka_bold"
            android:text="POTVRDI"
            app:cornerRadius="14dp" />
    </LinearLayout>

</LinearLayout>