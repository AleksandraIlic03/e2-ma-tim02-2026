<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FBF7EF"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/gameContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/btnNextGame"
        android:orientation="vertical">

        <!-- Player info panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/input_bg_rounded"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:orientation="vertical">
                    <TextView android:id="@+id/tvPlayer1Name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/fredoka_semibold" android:text="P1" android:textColor="#877777" android:textSize="10sp" />
                    <TextView android:id="@+id/tvPlayer1Points" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/fredoka_bold" android:text="0" android:textColor="#321C1C" android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:fontFamily="@font/fredoka_bold"
                android:text="VS"
                android:textColor="#823FAB"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/input_bg_rounded"
                android:gravity="center_vertical|end"
                android:orientation="horizontal"
                android:padding="8dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:gravity="end"
                    android:orientation="vertical">
                    <TextView android:id="@+id/tvPlayer2Name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/fredoka_semibold" android:text="P2" android:textColor="#877777" android:textSize="10sp" />
                    <TextView android:id="@+id/tvPlayer2Points" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/fredoka_bold" android:text="0" android:textColor="#321C1C" android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fredoka_bold"
                android:text="🕒 02:00"
                android:textColor="#9575CD"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:fontFamily="@font/fredoka_bold"
                android:text="ASOCIJACIJE"
                android:textColor="#321C1C"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvPoints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:fontFamily="@font/fredoka_bold"
                android:text="⭐ 0"
                android:textColor="#321C1C"
                android:textSize="18sp" />
        </RelativeLayout>

        <!-- Kolone A i B -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="5"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingHorizontal="4dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnA1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="A1" android:backgroundTint="#9575CD" app:cornerRadius="16dp" android:fontFamily="@font/fredoka_semibold" android:layout_marginBottom="4dp" android:textSize="13sp" android:textColor="#FFFFFF" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnA2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="A2" android:backgroundTint="#9575CD" app:cornerRadius="16dp" android:fontFamily="@font/fredoka_semibold" android:layout_marginBottom="4dp" android:textSize="13sp" android:textColor="#FFFFFF" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnA3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="A3" android:backgroundTint="#9575CD" app:cornerRadius="16dp" android:fontFamily="@font/fredoka_semibold" android:layout_marginBottom="4dp" android:textSize="13sp" android:textColor="#FFFFFF" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnA4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="A4" android:backgroundTint="#9575CD" app:cornerRadius="16dp" android:fontFamily="@font/fredoka_semibold" android:layout_marginBottom="4dp" android:textSize="13sp" android:textColor="#FFFFFF" />
                <EditText android:id="@+id/etResenjeA" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/input_bg_rounded" android:gravity="center" android:hint="REŠENJE A" android:inputType="textCapCharacters" android:imeOptions="actionDone" android:singleLine="true" android:textColor="#6A1B9A" android:fontFamily="@font/fredoka_bold" android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingHorizontal="4dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnB1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="B1" android:backgroundTint="#9575CD" app:cornerRadius="16dp" android:fontFamily="@font/fredoka_semibold" android:layout_marginBottom="4dp" android:textSize="13sp" android:textColor="#FFFFFF" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnB2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="B2" android:backgroundTint="#9575CD" app:cornerRadius="16dp" android:fontFamily="@font/fredoka_semibold" android:layout_marginBottom="4dp" android:textSize="13sp" android:textColor="#FFFFFF" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnB3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="B3" android:backgroundTint="#9575CD" app:cornerRadius="16dp" android:fontFamily="@font/fredoka_semibold" android:layout_marginBottom="4dp" android:textSize="13sp" android:textColor="#FFFFFF" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnB4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="B4" android:backgroundTint="#9575CD" app:cornerRadius="16dp" android:fontFamily="@font/fredoka_semibold" android:layout_marginBottom="4dp" android:textSize="13sp" android:textColor="#FFFFFF" />
                <EditText android:id="@+id/etResenjeB" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/input_bg_rounded" android:gravity="center" android:hint="REŠENJE B" android:inputType="textCapCharacters" android:imeOptions="actionDone" android:singleLine="true" android:textColor="#6A1B9A" android:fontFamily="@font/fredoka_bold" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <EditText
            android:id="@+id/etKonacnoResenje"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:layout_marginVertical="6dp"
            android:background="@drawable/final_resenje_bg"
            android:gravity="center"
            android:hint="KONAČNO REŠENJE"
            android:inputType="textCapCharacters"
            android:imeOptions="actionDone"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#B3FFFFFF"
            android:textSize="17sp"
            android:fontFamily="@font/fredoka_bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="5"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingHorizontal="4dp">
                <EditText android:id="@+id/etResenjeV" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/input_bg_rounded" android:gravity="center" android:hint="REŠENJE V" android:inputType="textCapCharacters" android:imeOptions="actionDone" android:singleLine="true" android:textColor="#6A1B9A" android:fontFamily="@font/fredoka_bold" android:textSize="13sp" android:layout_marginBottom="4dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnV1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="V1" android:backgroundTint="#9575CD" app:cornerRadius="16dp" android:fontFamily="@font/fredoka_semibold" android:layout_marginBottom="4dp" android:textSize="13sp" android:textColor="#FFFFFF" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnV2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="V2" android:backgroundTint="#9575CD" app:cornerRadius="16dp" android:fontFamily="@font/fredoka_semibold" android:layout_marginBottom="4dp" android:textSize="13sp" android:textColor="#FFFFFF" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnV3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="V3" android:backgroundTint="#9575CD" app:cornerRadius="16dp" android:fontFamily="@font/fredoka_semibold" android:layout_marginBottom="4dp" android:textSize="13sp" android:textColor="#FFFFFF" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnV4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="V4" android:backgroundTint="#9575CD" app:cornerRadius="16dp" android:fontFamily="@font/fredoka_semibold" android:textSize="13sp" android:textColor="#FFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingHorizontal="4dp">
                <EditText android:id="@+id/etResenjeG" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/input_bg_rounded" android:gravity="center" android:hint="REŠENJE G" android:inputType="textCapCharacters" android:imeOptions="actionDone" android:singleLine="true" android:textColor="#6A1B9A" android:fontFamily="@font/fredoka_bold" android:textSize="13sp" android:layout_marginBottom="4dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnG1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="G1" android:backgroundTint="#9575CD" app:cornerRadius="16dp" android:fontFamily="@font/fredoka_semibold" android:layout_marginBottom="4dp" android:textSize="13sp" android:textColor="#FFFFFF" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnG2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="G2" android:backgroundTint="#9575CD" app:cornerRadius="16dp" android:fontFamily="@font/fredoka_semibold" android:layout_marginBottom="4dp" android:textSize="13sp" android:textColor="#FFFFFF" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnG3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="G3" android:backgroundTint="#9575CD" app:cornerRadius="16dp" android:fontFamily="@font/fredoka_semibold" android:layout_marginBottom="4dp" android:textSize="13sp" android:textColor="#FFFFFF" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnG4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="G4" android:backgroundTint="#9575CD" app:cornerRadius="16dp" android:fontFamily="@font/fredoka_semibold" android:textSize="13sp" android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNextGame"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="10dp"
        android:text="SLEDEĆA IGRA"
        android:visibility="gone"
        android:backgroundTint="#823FAB"
        android:fontFamily="@font/fredoka_bold"
        android:textSize="18sp"
        app:cornerRadius="16dp" />

</RelativeLayout>
