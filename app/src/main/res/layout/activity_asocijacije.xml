<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FBF7EF"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fredoka_bold"
            android:text="🕒 04:00"
            android:textColor="#823FAB"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:fontFamily="@font/fredoka_bold"
            android:text="ASOCIJACIJE"
            android:textColor="#321C1C"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvPoints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:fontFamily="@font/fredoka_bold"
            android:text="⭐ 0"
            android:textColor="#321C1C"
            android:textSize="18sp" />
    </RelativeLayout>

    <!-- Kolone A i B -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5"
        android:orientation="horizontal">

        <!-- Kolona A -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="4dp">

            <com.google.android.material.button.MaterialButton android:id="@+id/btnA1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="A1" android:backgroundTint="#42A5F5" app:cornerRadius="16dp" android:fontFamily="@font/fredoka_semibold" android:layout_marginBottom="4dp" android:textSize="13sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnA2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="A2" android:backgroundTint="#42A5F5" app:cornerRadius="16dp" android:fontFamily="@font/fredoka_semibold" android:layout_marginBottom="4dp" android:textSize="13sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnA3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="A3" android:backgroundTint="#42A5F5" app:cornerRadius="16dp" android:fontFamily="@font/fredoka_semibold" android:layout_marginBottom="4dp" android:textSize="13sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnA4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="A4" android:backgroundTint="#42A5F5" app:cornerRadius="16dp" android:fontFamily="@font/fredoka_semibold" android:layout_marginBottom="4dp" android:textSize="13sp" />

            <EditText
                android:id="@+id/etResenjeA"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/input_bg_rounded"
                android:gravity="center"
                android:hint="REŠENJE A"
                android:inputType="textCapCharacters"
                android:textColor="#823FAB"
                android:fontFamily="@font/fredoka_bold"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Kolona B -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="4dp">

            <com.google.android.material.button.MaterialButton android:id="@+id/btnB1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="B1" android:backgroundTint="#42A5F5" app:cornerRadius="16dp" android:fontFamily="@font/fredoka_semibold" android:layout_marginBottom="4dp" android:textSize="13sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnB2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="B2" android:backgroundTint="#42A5F5" app:cornerRadius="16dp" android:fontFamily="@font/fredoka_semibold" android:layout_marginBottom="4dp" android:textSize="13sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnB3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="B3" android:backgroundTint="#42A5F5" app:cornerRadius="16dp" android:fontFamily="@font/fredoka_semibold" android:layout_marginBottom="4dp" android:textSize="13sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnB4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="B4" android:backgroundTint="#42A5F5" app:cornerRadius="16dp" android:fontFamily="@font/fredoka_semibold" android:layout_marginBottom="4dp" android:textSize="13sp" />

            <EditText
                android:id="@+id/etResenjeB"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/input_bg_rounded"
                android:gravity="center"
                android:hint="REŠENJE B"
                android:inputType="textCapCharacters"
                android:textColor="#823FAB"
                android:fontFamily="@font/fredoka_bold"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Konačno Rešenje -->
    <EditText
        android:id="@+id/etKonacnoResenje"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="4dp"
        android:layout_marginVertical="6dp"
        android:background="@drawable/final_resenje_bg"
        android:gravity="center"
        android:hint="KONAČNO REŠENJE"
        android:inputType="textCapCharacters"
        android:textColor="#FFFFFF"
        android:textColorHint="#B3FFFFFF"
        android:textSize="17sp"
        android:fontFamily="@font/fredoka_bold" />

    <!-- Kolone V i G -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5"
        android:orientation="horizontal">

        <!-- Kolona V -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="4dp">

            <EditText
                android:id="@+id/etResenjeV"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/input_bg_rounded"
                android:gravity="center"
                android:hint="REŠENJE V"
                android:inputType="textCapCharacters"
                android:textColor="#823FAB"
                android:fontFamily="@font/fredoka_bold"
                android:textSize="13sp"
                android:layout_marginBottom="4dp"/>

            <com.google.android.material.button.MaterialButton android:id="@+id/btnV1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="V1" android:backgroundTint="#42A5F5" app:cornerRadius="16dp" android:fontFamily="@font/fredoka_semibold" android:layout_marginBottom="4dp" android:textSize="13sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnV2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="V2" android:backgroundTint="#42A5F5" app:cornerRadius="16dp" android:fontFamily="@font/fredoka_semibold" android:layout_marginBottom="4dp" android:textSize="13sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnV3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="V3" android:backgroundTint="#42A5F5" app:cornerRadius="16dp" android:fontFamily="@font/fredoka_semibold" android:layout_marginBottom="4dp" android:textSize="13sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnV4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="V4" android:backgroundTint="#42A5F5" app:cornerRadius="16dp" android:fontFamily="@font/fredoka_semibold" android:textSize="13sp" />
        </LinearLayout>

        <!-- Kolona G -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="4dp">

            <EditText
                android:id="@+id/etResenjeG"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/input_bg_rounded"
                android:gravity="center"
                android:hint="REŠENJE G"
                android:inputType="textCapCharacters"
                android:textColor="#823FAB"
                android:fontFamily="@font/fredoka_bold"
                android:textSize="13sp"
                android:layout_marginBottom="4dp"/>

            <com.google.android.material.button.MaterialButton android:id="@+id/btnG1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="G1" android:backgroundTint="#42A5F5" app:cornerRadius="16dp" android:fontFamily="@font/fredoka_semibold" android:layout_marginBottom="4dp" android:textSize="13sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnG2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="G2" android:backgroundTint="#42A5F5" app:cornerRadius="16dp" android:fontFamily="@font/fredoka_semibold" android:layout_marginBottom="4dp" android:textSize="13sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnG3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="G3" android:backgroundTint="#42A5F5" app:cornerRadius="16dp" android:fontFamily="@font/fredoka_semibold" android:layout_marginBottom="4dp" android:textSize="13sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnG4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="G4" android:backgroundTint="#42A5F5" app:cornerRadius="16dp" android:fontFamily="@font/fredoka_semibold" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>