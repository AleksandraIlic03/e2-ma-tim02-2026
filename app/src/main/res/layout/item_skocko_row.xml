<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="8dp"
    android:paddingVertical="3dp">

    <!-- 4 polja za simbole -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageView
            android:id="@+id/ivSymbol1"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_margin="3dp"
            android:background="@drawable/circle_placeholder"
            android:backgroundTint="#C8BDD9"
            android:padding="8dp"
            android:scaleType="centerInside" />

        <ImageView
            android:id="@+id/ivSymbol2"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_margin="3dp"
            android:background="@drawable/circle_placeholder"
            android:backgroundTint="#C8BDD9"
            android:padding="8dp"
            android:scaleType="centerInside" />

        <ImageView
            android:id="@+id/ivSymbol3"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_margin="3dp"
            android:background="@drawable/circle_placeholder"
            android:backgroundTint="#C8BDD9"
            android:padding="8dp"
            android:scaleType="centerInside" />

        <ImageView
            android:id="@+id/ivSymbol4"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_margin="3dp"
            android:background="@drawable/circle_placeholder"
            android:backgroundTint="#C8BDD9"
            android:padding="8dp"
            android:scaleType="centerInside" />
    </LinearLayout>

    <!-- 2x2 hint tačkice -->
    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2"
        android:layout_marginStart="8dp">

        <ImageView
            android:id="@+id/ivHint1"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_margin="2dp"
            android:src="@drawable/small_circle_placeholder"
            app:tint="#DADCE0" />

        <ImageView
            android:id="@+id/ivHint2"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_margin="2dp"
            android:src="@drawable/small_circle_placeholder"
            app:tint="#DADCE0" />

        <ImageView
            android:id="@+id/ivHint3"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_margin="2dp"
            android:src="@drawable/small_circle_placeholder"
            app:tint="#DADCE0" />

        <ImageView
            android:id="@+id/ivHint4"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_margin="2dp"
            android:src="@drawable/small_circle_placeholder"
            app:tint="#DADCE0" />
    </GridLayout>

</LinearLayout>